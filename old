-- Логика Фракций (3 Альянса + GOC против всех)
local function GetFaction(player)
    if not player or not player.Team then return -1 end
    local t = player.Team.Name:lower()
    
    if t:find("cd") or t:find("class d") or t:find("ci") or t:find("chaos") then
        return 1 
    elseif t:find("fp") or t:find("facility") or t:find("scientist") or t:find("sd") or t:find("security") or t:find("mtf") or t:find("mobile task") or t:find("nine") then
        return 2 
    elseif t:find("scp") or t:find("sh") or t:find("serpent") then
        return 3 
    elseif t:find("goc") or t:find("global") then
        return 4 
    end
    return -1 
end

local function IsEnemy(p1, p2)
    if not cfg.aimbot.teamCheck then return true end
    local f1 = GetFaction(p1)
    local f2 = GetFaction(p2)
    if f1 == -1 or f2 == -1 then return false end
    return f1 ~= f2 
end

local function GetPlayerRole(player)
    local roleObj = player:FindFirstChild("Role")
    if roleObj and roleObj:IsA("StringValue") then
        return roleObj.Value
    end
    local attrRole = player:GetAttribute("Role")
    if attrRole then return tostring(attrRole) end
    return "SCP"
end

