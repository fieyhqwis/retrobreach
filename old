local function GetClosestPlayer()
    local target, dist = nil, math.huge
    local mouseLoc = UserInputService:GetMouseLocation()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and isAlive(p) and not isWhitelisted(p) then
            if IsEnemy(localPlayer, p) then
                local part = p.Character:FindFirstChild(cfg.aimbot.targetPart)
                if part and getTargetVisibility(part) then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local magnitude = (Vector2.new(pos.X, pos.Y) - mouseLoc).Magnitude
                        if magnitude < cfg.aimbot.fovRadius and magnitude < dist then
                            target = p; dist = magnitude
                        end
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    local mouseLoc = UserInputService:GetMouseLocation()
    FovFrame.Size = UDim2.new(0, cfg.aimbot.fovRadius * 2, 0, cfg.aimbot.fovRadius * 2)
    FovFrame.Position = UDim2.new(0, mouseLoc.X - cfg.aimbot.fovRadius, 0, mouseLoc.Y - cfg.aimbot.fovRadius)

    if cfg.lighting.fullbright then
        Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.GlobalShadows = false
    else
        Lighting.Brightness = originalLightingData.Brightness; Lighting.ClockTime = originalLightingData.ClockTime; Lighting.GlobalShadows = originalLightingData.GlobalShadows
    end
    
    if cfg.lighting.noFog then
        Lighting.FogEnd = 100000
        for _, v in pairs(Lighting:GetChildren()) do if v:IsA("Atmosphere") then v.Density = 0 end end
    else
        Lighting.FogEnd = originalLightingData.FogEnd
        for _, v in pairs(Lighting:GetChildren()) do if v:IsA("Atmosphere") then v.Density = originalLightingData.AtmosphereDensity end end
    end

    lblAim.Text = "AIM: " .. (cfg.aimbot.active and cfg.aimbot.mode:upper() or "OFF")
    lblAim.TextColor3 = cfg.aimbot.active and (cfg.aimbot.mode == "Legit" and cfg.ui.theme or Color3.fromRGB(255, 50, 50)) or Color3.new(1,0.5,0.5)
    lblESP.Text = "ESP: " .. (cfg.esp.enabled and "ON" or "OFF")
    lblESP.TextColor3 = cfg.esp.enabled and cfg.ui.theme or Color3.new(1,0.5,0.5)
    
    local m = workspace:FindFirstChild("SCP035_DroppedMask", true)
    contMask.Visible = cfg.maskEsp.enabled
    lblMask.Text = "MASK: " .. (m and "DETECTED" or "NONE")
    lblMask.TextColor3 = m and Color3.new(1,0.7,0) or Color3.new(1,1,1)

    if cfg.teamStats.enabled then
        local st = "<b><font color='#ffffff'>TEAM COUNTS:</font></b>\n\n"
        for _, t in ipairs(Teams:GetTeams()) do
            local hexColor = string.format("#%02X%02X%02X", t.TeamColor.Color.R*255, t.TeamColor.Color.G*255, t.TeamColor.Color.B*255)
            st = st .. '<font color="' .. hexColor .. '">' .. t.Name .. ": " .. #t:GetPlayers() .. "</font>\n"
        end
        lblTeams.Text = st
        contTeams.Visible = true
    else
        contTeams.Visible = false
    end

    if cfg.aimbot.active and isHoldingAim then
        if not isAlive(currentTarget) or isWhitelisted(currentTarget) or not IsEnemy(localPlayer, currentTarget) then
            currentTarget = GetClosestPlayer()
        end
        if currentTarget then
            local part = currentTarget.Character:FindFirstChild(cfg.aimbot.targetPart)
            if part then
                if cfg.aimbot.mode == "Legit" then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, part.Position), cfg.aimbot.smoothing)
                elseif cfg.aimbot.mode == "Rage" then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                end
            end
        end
    end

    -- === НОВАЯ ЛОГИКА ESP (СОРТИРОВКА ПО ДИСТАНЦИИ) ===
    local espTargets = {}
    local myPos = Camera.CFrame.Position
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        myPos = localPlayer.Character.HumanoidRootPart.Position
    end

    -- Собираем всех живых игроков и считаем дистанцию до них
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
            table.insert(espTargets, {plr = p, dist = dist})
        end
    end

    -- Сортируем: от ближайших к дальним
    table.sort(espTargets, function(a, b) return a.dist < b.dist end)

    -- Обновляем подсветку
    for i, data in ipairs(espTargets) do
        local p = data.plr
        
        local high = p.Character:FindFirstChild("Elite_ESP")
        if not high then
            high = Instance.new("Highlight")
            high.Name = "Elite_ESP"
            high.Parent = p.Character
        end
        high.Adornee = p.Character
        
        -- Выдаем Highlight только 25 ближайшим игрокам, чтобы не ломать лимит Роблокса
        if cfg.esp.enabled and i <= cfg.esp.maxHighlights then
            high.Enabled = true
        else
            high.Enabled = false
        end
        
        local isWl = isWhitelisted(p)
        local isEnm = IsEnemy(localPlayer, p)
        local isSCP = p.Team and p.Team.Name:lower():find("scp") ~= nil
        
        if isWl then 
            high.FillColor = Color3.new(1,1,1) 
        else
            high.FillColor = (p.Team and p.Team.TeamColor.Color) or Color3.new(1,0,0)
        end

        local head = p.Character:FindFirstChild("Head")
        if head then
            local bb = head:FindFirstChild("OverheadElite")
            if bb then
                local lbl = bb.MainText
                local hp = p.Character:FindFirstChild("Humanoid") and math.floor(p.Character.Humanoid.Health) or 0
                
                if isWl then
                    lbl.Text = "[ FRIEND ] " .. p.Name
                    lbl.TextColor3 = Color3.new(0, 1, 1)
                    lbl.Visible = cfg.esp.enabled
                elseif isSCP and hp > 0 then
                    local scpRole = GetPlayerRole(p)
                    lbl.Text = scpRole .. " " .. hp .. " HP"
                    lbl.TextColor3 = Color3.new(1, 0.3, 0.3)
                    lbl.Visible = cfg.esp.enabled
                elseif isEnm and hp > 0 then
                    lbl.Text = "HP: " .. hp
                    lbl.TextColor3 = Color3.new(1, 0.3, 0.3)
                    lbl.Visible = cfg.esp.enabled
                else
                    lbl.Visible = false
                end
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(i, g)
    if waitingForKey then
        if i.KeyCode ~= Enum.KeyCode.Unknown then
            cfg.aimbot.bind = i.KeyCode
            BindBtn.Text = "  AIM KEY: [" .. i.KeyCode.Name .. "]"
            BindBtn.TextColor3 = Color3.new(1,1,1)
            waitingForKey = false
        end
        return
    end
    if g then return end
    
    if i.KeyCode == cfg.ui.openKey then
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
    end
    
    if i.KeyCode == cfg.aimbot.bind then
        cfg.aimbot.active = not cfg.aimbot.active
    end
    if i.UserInputType == cfg.aimbot.activation then
        isHoldingAim = true
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == cfg.aimbot.activation then
        isHoldingAim = false
        currentTarget = nil
    end
end)
