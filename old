local function ManageTags(p)
    if p == localPlayer then return end
    local function apply()
        local char = p.Character or p.CharacterAdded:Wait()
        local head = char:WaitForChild("Head", 5)
        if not head then return end
        local bb = head:FindFirstChild("OverheadElite") or Instance.new("BillboardGui", head)
        bb.Name = "OverheadElite"
        bb.Size = UDim2.new(0, 250, 0, 60)
        bb.AlwaysOnTop = true
        bb.StudsOffset = Vector3.new(0, 3, 0)
        local text = bb:FindFirstChild("MainText") or Instance.new("TextLabel", bb)
        text.Name = "MainText"
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.TextStrokeTransparency = 0.5
        text.Font = Enum.Font.GothamBold
        text.TextSize = 14
    end
    p.CharacterAdded:Connect(apply)
    if p.Character then apply() end
end
