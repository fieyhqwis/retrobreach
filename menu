local lastTPTime     = 0
local currentTPTween = nil

local function getMyHRP()
	local data = CharCache[LocalPlayer]
	if data and data.HRP and data.HRP.Parent then return data.HRP end
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function instantTP(position)
	local now = os.clock()
	if now - lastTPTime < 0.15 then return end
	lastTPTime = now

	local hrp = getMyHRP()
	if not hrp then return end
	if currentTPTween then
		currentTPTween:Cancel()
		currentTPTween = nil
	end
	hrp.CFrame = CFrame.new(position + Vector3.new(0, 3.5, 0))
end

local function tweenTo(position)
	local hrp = getMyHRP()
	if not hrp then return end
	if currentTPTween then
		currentTPTween:Cancel()
		currentTPTween = nil
	end
	local target = position + Vector3.new(0, 3, 0)
	local dist   = (target - hrp.Position).Magnitude
	local dur    = math.clamp(dist / math.max(Settings.TPTweenSpeed, 1), 0.1, 20)
	local tween  = TweenService:Create(
		hrp,
		TweenInfo.new(dur, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(target) }
	)
	currentTPTween = tween
	tween.Completed:Once(function()
		currentTPTween = nil
	end)
	tween:Play()
end

