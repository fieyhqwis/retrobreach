local function getItemCategory(name)
	if name:find("Card", 1, true) then return "Cards" end
	if WEAPON_NAME_SET[name] then return "Weapons" end
	if name == "Medkit" or name == "Bandage" then return "Medical" end
	if name:find("Grenade", 1, true) then return "Grenades" end
	if name:find("SCP", 1, true) then return "SCP Items" end
	return "Other"
end

