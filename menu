	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRMBHeld = false
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		ctrlHeld = false
	end
end)

local savedLighting = nil
local savedEffects  = {}

local function captureLighting()
	if savedLighting then return end
	savedLighting = {
		Brightness     = Lighting.Brightness,
		Ambient        = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		ClockTime      = Lighting.ClockTime,
		FogStart       = Lighting.FogStart,
		FogEnd         = Lighting.FogEnd,
		GlobalShadows  = Lighting.GlobalShadows,
	}
	savedEffects = {}
	for _, eff in ipairs(Lighting:GetDescendants()) do
		if eff:IsA("Atmosphere") then
			savedEffects[#savedEffects + 1] = { Inst = eff, Prop = "Density", Val = eff.Density }
		elseif eff:IsA("BlurEffect") then
			savedEffects[#savedEffects + 1] = { Inst = eff, Prop = "Size", Val = eff.Size }
		end
	end
end

local function restoreLighting()
	if not savedLighting then return end
	for k, v in pairs(savedLighting) do
		Lighting[k] = v
	end
	for _, e in ipairs(savedEffects) do
		if e.Inst and e.Inst.Parent then
			e.Inst[e.Prop] = e.Val
		end
	end
	savedLighting = nil
	savedEffects  = {}
end

local function applyWorldVisuals()
	if Settings.NoFog or Settings.Fullbright then
		captureLighting()

		if Settings.Fullbright then
			Lighting.Brightness     = 3
			Lighting.Ambient        = Color3.new(1, 1, 1)
			Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
			Lighting.ClockTime      = 14
			Lighting.GlobalShadows  = false
		end

		if Settings.NoFog then
			Lighting.FogStart = 0
			Lighting.FogEnd   = 9e9
			for _, eff in ipairs(Lighting:GetDescendants()) do
				if eff:IsA("Atmosphere") then
					eff.Density = 0
				elseif eff:IsA("BlurEffect") then
					eff.Size = 0
				end
			end
		end
	elseif savedLighting then
		restoreLighting()
	end
end

local function getESPColor(player, hum)
	if Settings.ChamColorMode == "Custom" then
		return Settings.ChamFillColor
	elseif Settings.ChamColorMode == "Health" and hum then
		local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		return Color3.fromRGB(255 * (1 - hp) + 40, 40 + 215 * hp, 60)
	end
	return player.Team and player.TeamColor.Color or Color3.fromRGB(255, 255, 255)
end

local ESPStorage = {}

local function removeESP(player)
	local data = ESPStorage[player]
	if not data then return end
	if data.Box       then data.Box.Visible  = false; data.Box:Remove()  end
	if data.Text      then data.Text.Visible = false; data.Text:Remove() end
	if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
	ESPStorage[player] = nil
end

local function createESP(player)
	if player == LocalPlayer then return end
	if ESPStorage[player] then return end

	local box           = Drawing.new("Square")
	box.Thickness       = 1.5
	box.Filled          = false
	box.Transparency    = 1
	box.Visible         = false

	local text          = Drawing.new("Text")
	text.Size           = 14
	text.Center         = true
	text.Outline        = true
	text.OutlineColor   = Color3.fromRGB(0, 0, 0)
	text.Visible        = false

	ESPStorage[player] = { Box = box, Text = text, Highlight = nil, LastKey = nil }
end

local function updateChams(player)
	local data = ESPStorage[player]
	if not data then return end
	local cData = CharCache[player]
	local char  = cData and cData.Char

	if Settings.ESPMode ~= "Chams" or not (char and char.Parent) then
		if data.Highlight then
			data.Highlight:Destroy()
			data.Highlight = nil
		end
		return
	end

	local hl = data.Highlight
	if not hl or hl.Parent ~= char then
		if hl then hl:Destroy() end
		hl             = Instance.new("Highlight")
		hl.Name        = "ESP_Chams"
		hl.Enabled     = true
		hl.Parent      = char
		data.Highlight = hl
	end

	local color = getESPColor(player, cData.Hum)
	hl.FillColor           = color
	hl.OutlineColor        = color
	hl.FillTransparency    = Settings.ChamFillTrans
	hl.OutlineTransparency = 0.05
	hl.DepthMode           = Settings.ChamThroughWalls
		and Enum.HighlightDepthMode.AlwaysOnTop
		or  Enum.HighlightDepthMode.Occluded
	hl.Enabled             = true
end

local function updateOverlay(player)
	local data = ESPStorage[player]
	if not data then return end

	if Settings.ESPMode == "Disabled" then
		if data.Box.Visible or data.Text.Visible then
			data.Box.Visible  = false
			data.Text.Visible = false
		end
		return
	end

	local cData = CharCache[player]
	local char  = cData and cData.Char
	local hrp   = cData and cData.HRP
	local hum   = cData and cData.Hum

	if not (char and hrp and hum and hum.Health > 0) then
		if data.Box.Visible or data.Text.Visible then
			data.Box.Visible  = false
			data.Text.Visible = false
		end
		return
	end

	local vec, onScreen = Camera:WorldToViewportPoint(hrp.Position)
	if not onScreen then
		if data.Box.Visible or data.Text.Visible then
			data.Box.Visible  = false
			data.Text.Visible = false
		end
		return
	end

	local espColor = getESPColor(player, hum)
	local vp       = Camera.ViewportSize

	local headVec = cData.Head
		and Camera:WorldToViewportPoint(cData.Head.Position + Vector3.new(0, 0.5, 0))
		or  vec
	local legVec = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

	local height = math.abs(headVec.Y - legVec.Y)
	local width  = height / 1.5

	if height <= 0 or height > vp.Y * 1.5 or width > vp.X * 1.5 then
		data.Box.Visible  = false
		data.Text.Visible = false
		return
	end

	local wantBox = (Settings.ESPMode == "Drawing 2D") or Settings.ShowBoxOnChams
	if wantBox then
		data.Box.Size     = Vector2.new(width, height)
		data.Box.Position = Vector2.new(vec.X - width / 2, vec.Y - height / 2)
		data.Box.Color    = espColor
		data.Box.Visible  = true
	else
		data.Box.Visible  = false
	end

	local roleLine = nil
	if Settings.ShowRoleAttr then
		local roleAttr = char:GetAttribute("Role")
		if roleAttr then roleLine = "[" .. tostring(roleAttr) .. "]" end
	end

	local nameLine, teamLine, hpLine, distLine = nil, nil, nil, nil
	if Settings.ShowName     then nameLine = player.Name end
	if Settings.ShowTeam     then teamLine = "[" .. (player.Team and player.Team.Name or "No Team") .. "]" end
	if Settings.ShowHP       then hpLine   = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
	if Settings.ShowDistance then distLine = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude) .. "m" end

	local key = tostring(nameLine) .. "|" .. tostring(teamLine) .. "|" ..
		tostring(hpLine) .. "|" .. tostring(distLine) .. "|" ..
		tostring(roleLine)

	if data.LastKey ~= key then
		local parts = {}
		if nameLine then parts[#parts+1] = nameLine end
		if teamLine then parts[#parts+1] = teamLine end
		if roleLine then parts[#parts+1] = roleLine end
		if hpLine   then parts[#parts+1] = hpLine   end
		if distLine then parts[#parts+1] = distLine end
		data.Text.Text = table.concat(parts, NL)
		data.LastKey   = key
	end

	data.Text.Position = Vector2.new(vec.X, vec.Y - (height / 2) - 52)
	data.Text.Color    = espColor
	data.Text.Visible  = true
end

local function hardRefreshESP()
	for _, data in pairs(ESPStorage) do
		if data.Highlight then
			data.Highlight:Destroy()
			data.Highlight = nil
		end
		data.Box.Visible  = false
		data.Text.Visible = false
		data.LastKey      = nil
	end

	for plr in pairs(CharCache) do
		if plr.Character then
			cacheCharacter(plr, plr.Character)
		else
			CharCache[plr] = nil
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			createESP(plr)
			if plr.Character and not CharCache[plr] then
				cacheCharacter(plr, plr.Character)
			end
		end
	end
end

