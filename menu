	Name     = "Teleport to Nearest 035",
	Callback = function()
		local camPos = Camera.CFrame.Position
		local best, bestDist = nil, math.huge
		for _, inst in ipairs(scp035Cache) do
			if inst.Parent then
				local d = (camPos - resolve035Pos(inst)).Magnitude
				if d < bestDist then
					bestDist = d
					best = inst
				end
			end
		end
		if best then
			instantTP(resolve035Pos(best))
			Rayfield:Notify({ Title = "SCP-035", Content = "Warped to mask.", Duration = 2 })
