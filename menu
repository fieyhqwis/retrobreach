local CharCache = {}

local function cacheCharacter(player, char)
	if not char then return end
	task.spawn(function()
		local hum, hrp, head
		local deadline = os.clock() + 120
		while char.Parent and os.clock() < deadline do
			hum  = char:FindFirstChildOfClass("Humanoid")
			hrp  = char:FindFirstChild("HumanoidRootPart")
			head = char:FindFirstChild("Head")
			if hum and hrp and head then break end
			task.wait(0.25)
		end
		if hum and hrp and head and char.Parent and player.Character == char then
			CharCache[player] = { Char = char, Hum = hum, HRP = hrp, Head = head }
		end
	end)
end

local function trackPlayer(player)
	player.CharacterAdded:Connect(function(char)
		CharCache[player] = nil
		cacheCharacter(player, char)
	end)
	player.CharacterRemoving:Connect(function()
		CharCache[player] = nil
	end)
	if player.Character then
		cacheCharacter(player, player.Character)
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	trackPlayer(plr)
end
