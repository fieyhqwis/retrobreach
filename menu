local function resolve035Pos(obj)
	if obj:IsA("BasePart") then return obj.Position end
	local pp = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	if pp then return pp.Position end
	return obj:GetPivot().Position
end

local function updateSCP035ESP()
	if not Settings.SCP035ESPEnabled then
		for i = 1, #SCP035Pool do SCP035Pool[i].Visible = false end
		return
	end

	local camPos  = Camera.CFrame.Position
	local maxDist = Settings.SCP035MaxDistance
	local idx     = 0

	for _, obj in ipairs(scp035Cache) do
		if obj.Parent then
			local pos = resolve035Pos(obj)
			local dist = (camPos - pos).Magnitude
			if maxDist <= 0 or dist <= maxDist then
				local vec, onScreen = Camera:WorldToViewportPoint(pos)
				if onScreen and vec.Z > 0 then
					idx += 1
					if idx > 100 then break end
					local t = getSCP035Text(idx)

					local role = obj:GetAttribute("Role")
					if role == nil then
						for _, child in ipairs(obj:GetChildren()) do
							if child.GetAttribute then
								role = child:GetAttribute("Role")
								if role then break end
							end
						end
					end

					local lines = { "SCP-035" }
					if Settings.SCP035ShowRole and role then
						lines[#lines + 1] = "[" .. tostring(role) .. "]"
					end
					lines[#lines + 1] = math.floor(dist) .. "m"

					t.Text     = table.concat(lines, NL)
					t.Color    = Settings.SCP035Color
					t.Position = Vector2.new(vec.X, vec.Y - 18 - (#lines - 1) * 10)
					t.Visible  = true
				end
			end
		end
	end

	for i = idx + 1, #SCP035Pool do
		SCP035Pool[i].Visible = false
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType  = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local scratchFilter = {}

local function isVisibleMulti(targetChar)
	local parts = {}
	local head = targetChar:FindFirstChild("Head")
	if head then parts[#parts + 1] = head end
	if Settings.VisParts ~= "Head" then
		local torso = targetChar:FindFirstChild("UpperTorso")
			or targetChar:FindFirstChild("Torso")
		if torso then parts[#parts + 1] = torso end
	end
	if #parts == 0 then return false end

	table.clear(scratchFilter)
	scratchFilter[#scratchFilter + 1] = Camera
	local myChar = LocalPlayer.Character
	if myChar then scratchFilter[#scratchFilter + 1] = myChar end
	for _, data in pairs(CharCache) do
		if data.Char and data.Char ~= targetChar then
			scratchFilter[#scratchFilter + 1] = data.Char
		end
	end
	if Settings.IgnoreGateBarrier then
		for _, inst in ipairs(barrierIgnoreList) do
			scratchFilter[#scratchFilter + 1] = inst
		end
	end
	rayParams.FilterDescendantsInstances = scratchFilter

	local origin = Camera.CFrame.Position
	for _, part in ipairs(parts) do
		local result = Workspace:Raycast(origin, part.Position - origin, rayParams)
		if result == nil or result.Instance:IsDescendantOf(targetChar) then
			return true
		end
	end
	return false
end

local function getCombatPart(entry)
	if entry.Char then
		if Settings.TargetPart == "Head" and entry.Head then return entry.Head end
		return entry.HRP
	end
	local char = entry
	return (Settings.TargetPart == "Head" and char:FindFirstChild("Head"))
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("HumanoidRootPart")
end

local function getClosestTarget()
	local anchor    = getFovAnchor()
	local bestPart  = nil
	local bestChar  = nil
	local bestScore = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if Settings.TeamCheck then
				local sameTeam =
					(player.Team      and LocalPlayer.Team      and player.Team      == LocalPlayer.Team) or
					(player.TeamColor and LocalPlayer.TeamColor and player.TeamColor == LocalPlayer.TeamColor)
				if sameTeam then continue end
			end

			local data = CharCache[player]
			if data and data.Hum.Health > 0 then
				local part = getCombatPart(data)
				if part then
					local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local d2d   = (Vector2.new(screenPos.X, screenPos.Y) - anchor).Magnitude
						local inFOV = (not Settings.FOVEnabled) or (d2d <= Settings.FOVRadius)
						if inFOV and ((not Settings.WallCheck) or isVisibleMulti(data.Char)) then
							local score = d2d + (part.Position - Camera.CFrame.Position).Magnitude * 0.01
							if score < bestScore then
								bestScore = score
								bestPart  = part
								bestChar  = data.Char
							end
						end
					end
				end
			end
		end
	end

	if not bestPart and Settings.NPCCheck then
		for _, npc in ipairs(cachedNPCs) do
			if npc and npc.Parent then
				local hum = npc:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local part = getCombatPart(npc)
					if part then
						local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
						if onScreen then
							local d2d   = (Vector2.new(screenPos.X, screenPos.Y) - anchor).Magnitude
							local inFOV = (not Settings.FOVEnabled) or (d2d <= Settings.FOVRadius)
							if inFOV and ((not Settings.WallCheck) or isVisibleMulti(npc)) then
								local score = d2d + (part.Position - Camera.CFrame.Position).Magnitude * 0.01
								if score < bestScore then
									bestScore = score
									bestPart  = part
									bestChar  = npc
								end
							end
						end
					end
				end
			end
		end
	end

	return bestPart, bestChar
end

local lockRef    = nil
local blindSince = nil

local function isLockValid()
	local L = lockRef
	if not L then return false end
	local part, char = L.part, L.char
	if not part or not part.Parent or not char.Parent then return false end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end

	local vec = Camera:WorldToViewportPoint(part.Position)
	if vec.Z <= 0 then return false end

	if Settings.FOVEnabled then
		local d2d = (Vector2.new(vec.X, vec.Y) - getFovAnchor()).Magnitude
		if d2d > Settings.FOVRadius * 1.35 then return false end
	end

	if Settings.WallCheck then
		if isVisibleMulti(char) then
			blindSince = nil
		else
			blindSince = blindSince or os.clock()
			if os.clock() - blindSince > Settings.WallGrace then return false end
		end
	end
	return true
end

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRMBHeld = true
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		ctrlHeld = true
	elseif input.KeyCode == Enum.KeyCode.RightShift then
		Settings.TeamCounterEnabled = not Settings.TeamCounterEnabled
	elseif input.UserInputType == Enum.UserInputType.MouseButton1
	   and Settings.ClickTP and ctrlHeld then
		local data = CharCache[LocalPlayer]
		local hrp  = data and data.HRP
		if hrp and LocalPlayer:GetMouse().Target then
			hrp.CFrame = CFrame.new(LocalPlayer:GetMouse().Hit.Position + Vector3.new(0, 3.5, 0))
		end
	end
end)

