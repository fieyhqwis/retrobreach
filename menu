local itemContainer = nil
task.spawn(function()
	itemContainer = Workspace:WaitForChild("ItemSpawns", 300)
end)

local function updateItemESP()
	if not Settings.ItemESPEnabled or not itemContainer or not itemContainer.Parent then
		for i = 1, #ItemPool do ItemPool[i].Visible = false end
		return
	end

	local camPos  = Camera.CFrame.Position
	local maxDist = Settings.ItemESPMaxDistance
	local filter  = Settings.ItemESPFilter
	local fLow    = filter ~= "" and string.lower(filter) or nil
	local idx     = 0

	for _, item in ipairs(itemContainer:GetChildren()) do
		local pos
		if item:IsA("BasePart") then
			pos = item.Position
		elseif item:IsA("Model") then
			pos = item:GetPivot().Position
		end
		if pos then
			local dist = (camPos - pos).Magnitude
			if maxDist <= 0 or dist <= maxDist then
				local name = item.Name
				if not fLow or string.lower(name):find(fLow, 1, true) then
					local cat = getItemCategory(name)
					if Settings.ItemESPCats[cat] then
						local vec, onScreen = Camera:WorldToViewportPoint(pos)
						if onScreen and vec.Z > 0 then
							idx += 1
							if idx > 400 then break end
							local t = getItemText(idx)
							local lines = {}
							if Settings.ShowItemName then lines[#lines + 1] = name end
							if Settings.ShowItemDistance then
								lines[#lines + 1] = math.floor(dist) .. "m"
							end
							t.Text     = table.concat(lines, NL)
							t.Color    = ITEM_CATEGORY_COLORS[cat] or Color3.new(1, 1, 1)
							t.Position = Vector2.new(vec.X, vec.Y - 14 - (#lines - 1) * 9)
							t.Visible  = true
						end
					end
				end
			end
		end
	end

	for i = idx + 1, #ItemPool do
		ItemPool[i].Visible = false
	end
end

