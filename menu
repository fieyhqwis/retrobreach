local frameCount = 0

RunService.RenderStepped:Connect(function(dt)
	frameCount += 1

	FOVCircle.Position = getFovAnchor()
	FOVCircle.Radius   = Settings.FOVRadius
	FOVCircle.Visible  = Settings.FOVEnabled and Settings.AimbotEnabled

	if Settings.WatermarkEnabled then
		if frameCount % 60 == 1 then
			Watermark.Text = table.concat({
				"Universal by Hardcok v5.5",
				"Aim: " .. (Settings.AimbotEnabled and "ON" or "OFF") .. " | Mode: " .. Settings.Mode,
				"ESP: " .. Settings.ESPMode,
				"Items: " .. (Settings.ItemESPEnabled and "ON" or "OFF") ..
					" | 035: " .. (Settings.SCP035ESPEnabled and "ON" or "OFF"),
			}, NL)
		end
		Watermark.Visible = true
	else
		Watermark.Visible = false
	end

	local activePart = nil
	if Settings.AimbotEnabled and isRMBHeld then
		if Settings.LockTarget then
			if lockRef and not isLockValid() then
				lockRef, blindSince = nil, nil
			end
			if not lockRef then
				local p, c = getClosestTarget()
				if p then
					lockRef    = { part = p, char = c }
					blindSince = nil
				end
			end
			activePart = lockRef and lockRef.part or nil
		else
			lockRef, blindSince = nil, nil
			activePart = getClosestTarget()
		end

		if activePart then
			local alpha = (Settings.Mode == "Rage")
				and 1
				or  math.clamp(dt * Settings.Smoothness, 0, 1)
			Camera.CFrame = Camera.CFrame:Lerp(
				CFrame.lookAt(Camera.CFrame.Position, activePart.Position),
				alpha
			)
		end
	else
		lockRef, blindSince = nil, nil
	end

	if Settings.TPWalk then
		local data = CharCache[LocalPlayer]
		local hum, hrp = data and data.Hum, data and data.HRP
		if hum and hrp and hum.MoveDirection.Magnitude > 0 then
			local extra = math.max(Settings.TPWalkSpeed - BASE_WALKSPEED, 0)
			hrp.CFrame = hrp.CFrame + hum.MoveDirection * extra * dt
		end
	end

	if frameCount % 2 == 0 then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				updateChams(player)
				updateOverlay(player)
			end
		end
	end

	if frameCount % 4 == 0 then
		updateItemESP()
		updateSCP035ESP()
	end

	if frameCount % 30 == 0 then
		applyWorldVisuals()
	end
end)

