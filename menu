local function updateTeamCounter()
	if not Settings.TeamCounterEnabled then
		TCFrame.Visible = false
		return
	end
	TCFrame.Visible = true

	local idx = 1
	for _, team in ipairs(Teams:GetTeams()) do
		local count = 0
		for _, plr in ipairs(team:GetPlayers()) do
			local data = CharCache[plr]
			local hum  = data and data.Hum
				or plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				count += 1
			end
		end
		local row      = getTCRow(idx)
		row.Text       = team.Name .. ": " .. count
		row.TextColor3 = team.TeamColor.Color
		row.Visible    = true
		idx += 1
	end

	for i = idx, #tcRowCache do
		tcRowCache[i].Visible = false
	end
end

